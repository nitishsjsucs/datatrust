{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nitishsjsucs/datatrust/schemas/api/check_result.json",
  "title": "CheckResult",
  "description": "One check outcome from a dbt build, produced by the runner from run_results.json (SPEC 7.2, 13.1). Mirrored by CheckResultSchema (zod) in apps/worker/src/schemas.ts. Carries counts, node ids, column names and dbt's message, never row values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "testName", "category", "kind", "status", "failures", "node", "columns"],
  "properties": {
    "checkId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "testName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "category": { "type": "string", "minLength": 1, "maxLength": 64 },
    "kind": { "enum": ["data_test", "schema_contract", "model_error"] },
    "status": { "enum": ["pass", "fail", "error", "skip"] },
    "failures": { "type": "integer", "minimum": 0 },
    "node": { "type": "string", "minLength": 1, "maxLength": 300 },
    "columns": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 200 },
    "message": { "type": ["string", "null"], "maxLength": 4000 },
    "also": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "columns"],
        "properties": { "node": { "type": "string" }, "columns": { "type": "array", "items": { "type": "string" } } }
      }
    }
  }
}
