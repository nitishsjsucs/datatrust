# Copy to .env.prod (gitignored) and chmod 600. Never put CLOUDFLARE_API_TOKEN here (SPEC section 14.4).
# Production runs on the Cloudflare Workers Free plan (SPEC section 28); nothing here needs Workers Paid.
# `npm run setup:wizard` fills these in and pre-fills the values known on 2026-10-10 (SPEC section 21).

# Runner (SPEC section 14.4)
DATATRUST_API_URL=
DATATRUST_TARGET=
DATATRUST_DUCKDB_PATH=
DATATRUST_SNAPSHOT_DIR=
# The shared Google Cloud project (master-magnet-444903-u4) and BigQuery location (US)
DATATRUST_GCP_PROJECT=
DATATRUST_BQ_LOCATION=
DATATRUST_PROBER_SA=
EVIDENCE_HMAC_KEY=
DATATRUST_DEV_TOKEN=
# Access service token datatrust-runner (role runner: lease jobs, post results, export the lake)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Access service token datatrust-operator (roles operator, viewer: `datatrust run --env prod`, prod:smoke)
CF_ACCESS_OPERATOR_CLIENT_ID=
CF_ACCESS_OPERATOR_CLIENT_SECRET=

# Basin Catalog (Iceberg REST catalog on R2 datatrust-lake) for `datatrust lake commit --catalog basin`
# (SPEC sections 13.9, 28.5.1). setup:prod writes the URI and warehouse; the token is an R2 API token.
BASIN_CATALOG_URI=
BASIN_WAREHOUSE=
BASIN_CATALOG_TOKEN=

# Production bootstrap only (SPEC sections 14.4, 21)
# Cloudflare account dc93c3bc8aa4f9e09a0d7e7354a80873 (shown by `npx wrangler whoami`)
CLOUDFLARE_ACCOUNT_ID=
# Optional narrow token (AI Gateway Read and Edit) used only to create the AI Gateway
DATATRUST_CF_API_TOKEN=
# The email you log in to Cloudflare Access with (operator and viewer in the Worker)
DATATRUST_OPERATOR_EMAIL=
# Optional: the Google account that runs dbt (default: the active gcloud account); gets Fine-Grained Reader
DATATRUST_GCP_USER=
ACCESS_AUD=
# Zero Trust team domain, https://old-truth-a7dc.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
