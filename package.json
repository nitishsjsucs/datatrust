{
  "name": "datatrust",
  "version": "0.1.0",
  "private": true,
  "description": "Lineage-aware data quality and root-cause analysis for workforce data",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/rca",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "setup": "npm ci && uv sync --locked",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:rca && npm run test:worker && npm run test -w @datatrust/web && uv run pytest",
    "test:rca": "npm run test -w @datatrust/rca",
    "test:worker": "npm run test -w @datatrust/worker",
    "bench": "uv run datatrust bench --mode offline --seeds 101-105 --dev-results results/bench-2026-10-10-offline-dev.json",
    "dev:keys": "node scripts/dev-keys.mjs",
    "dev:token": "node scripts/dev-token.mjs",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "dev:reset": "rm -rf apps/worker/.wrangler/state .data",
    "bench:e2e": "bash scripts/bench-e2e.sh",
    "prod:validate": "uv run datatrust prod validate",
    "prod:smoke": "uv run datatrust prod smoke",
    "doctor": "bash scripts/doctor.sh",
    "setup:prod": "bash scripts/setup-prod.sh",
    "deploy:prod": "bash scripts/setup-prod.sh --cloudflare-only"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
