{
  "name": "datatrust",
  "version": "0.1.0",
  "private": true,
  "description": "Lineage-aware data quality and root-cause analysis for workforce data",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/rca",
    "apps/worker"
  ],
  "scripts": {
    "setup": "npm ci && uv sync --locked",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:rca && npm run test:worker && uv run pytest",
    "test:rca": "npm run test -w @datatrust/rca",
    "test:worker": "npm run test -w @datatrust/worker",
    "bench": "uv run datatrust bench --mode offline --seeds 101-105 --dev-results results/bench-2026-10-10-offline-dev.json",
    "dev:keys": "node scripts/dev-keys.mjs",
    "dev:token": "node scripts/dev-token.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
