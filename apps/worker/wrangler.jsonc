// Local configuration (committed). No AI binding and no account ids: those are production only
// (wrangler.prod.template.jsonc). Runs under `wrangler dev --local` (Miniflare, workerd). Lake objects settle
// after 5 s locally instead of production's 120 s, so a local `datatrust lake commit` sees them sooner.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "datatrust",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datatrust",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "datatrust-artifacts" }],
  // Read-only incident dashboard (apps/web, built with `npm run build -w @datatrust/web`). API routes run the
  // Worker first; everything else is a static asset with SPA fallback.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  // Secrets: ACCESS_JWKS_JSON is local only (written by `npm run dev:keys` to .dev.vars). Declaring them here
  // keeps `wrangler types` independent of whatever .dev.vars holds on a given machine.
  "secrets": { "required": ["ACCESS_AUD", "ROLE_MAP_JSON", "EVIDENCE_HMAC_KEY", "ACCESS_JWKS_JSON"] },
  "queues": {
    "producers": [
      { "binding": "CHECK_RESULTS_Q", "queue": "datatrust-check-results" },
      { "binding": "LINEAGE_Q", "queue": "datatrust-lineage-events" },
      { "binding": "INVESTIGATE_Q", "queue": "datatrust-investigate" },
      { "binding": "AUDIT_Q", "queue": "datatrust-audit-events" }
    ],
    "consumers": [
      { "queue": "datatrust-check-results", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "datatrust-dlq" },
      { "queue": "datatrust-lineage-events", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "datatrust-dlq" },
      { "queue": "datatrust-investigate", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "datatrust-dlq" },
      { "queue": "datatrust-audit-events", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3, "dead_letter_queue": "datatrust-dlq" },
      { "queue": "datatrust-dlq", "max_batch_size": 10, "max_batch_timeout": 1 }
    ]
  },
  "workflows": [
    { "name": "datatrust-validation-run", "binding": "VALIDATION_RUN", "class_name": "ValidationRunWorkflow" },
    { "name": "datatrust-investigation", "binding": "INVESTIGATION", "class_name": "InvestigationWorkflow" }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "ACCESS_MODE": "local-jwks",
    "SUMMARIZER": "template",
    "LOCAL_LLM_URL": "http://127.0.0.1:8160",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_GATEWAY_ID": "datatrust",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_ISSUER": "http://127.0.0.1:8792/dev-access",
    "LAKE_SETTLE_SECONDS": "5",
    "VERSION": "0.1.0"
  }
}
